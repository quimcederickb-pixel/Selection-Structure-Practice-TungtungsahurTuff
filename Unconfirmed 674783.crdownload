import random

#Password Gatekeep

while True:
    passw = input("Enter your password (pass must be 8 characters long): ")
    if len(passw) == 8:
        print("Password length is valid.")

        #Two-step verification
        verificationcode = str(random.randint(1000, 9999))
        print(f"For your 2-step verification, please enter this code: {verificationcode}")

        attempts = 0
        while attempts < 3: # Allow up to 3 attempts for verification code
            user_code = input("Enter the 4-digit verification code: ")
            if user_code == verificationcode:
                print("Verification successful! YOU ARE LOGGED IN.")
                break
            else:
                attempts += 1
                if attempts < 3:
                    print("Incorrect code. Please try again.")
                else:
                    print("Too many incorrect attempts. ACCESS DENIED.")
        break # Exit the outer loop after password and verification
    else:
        print("ERROR Password must be exactly 8 characters long. Please try again.")